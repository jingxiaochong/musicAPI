# Copy this file to .env. Do not commit .env.

HOST=0.0.0.0
PORT=3000
NCM_WEB_PORT=8080
CHECK_VERSION=false

# Set this to the exact origin of your own player, or leave empty when access
# is only through the same origin/private network.
CORS_ALLOW_ORIGIN=

# Keep these disabled for the initial personal deployment.
ENABLE_PROXY=false
ENABLE_RANDOM_CN_IP=false
ENABLE_GENERAL_UNBLOCK=false
ENABLE_FLAC=true
SELECT_MAX_BR=false
FOLLOW_SOURCE_ORDER=true

# Optional: a cookie can be supplied through the server environment, but do
# not put an account password here. Prefer QR login and session cookies.
# NETEASE_COOKIE=
